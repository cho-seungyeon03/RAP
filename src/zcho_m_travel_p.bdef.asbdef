projection;
strict ( 2 );
use draft;
use side effects;

define behavior for zcho_m_travel_p //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _BOOKING { create; }

  use action setBooked;
  use action setDiscount;
  use action lineCopy;

  use action Activate;
  use action Discard;
  use action edit;
  use action prepare;
  use action resume;

}

define behavior for zcho_m_booking_p //alias <alias_name>
{
  use update;
  use delete;

  use association _TRAVEL;
}